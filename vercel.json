{
  "framework": null,
  "installCommand": "npm install --prefix \"Hi-Zer-Pharma-Nutraceutical backend\" && npm install --prefix \"Hi-Zer-Pharma-Nutraceutical frontend\"",
  "buildCommand": "npm run build --prefix \"Hi-Zer-Pharma-Nutraceutical frontend\"",
  "outputDirectory": "Hi-Zer-Pharma-Nutraceutical frontend/dist",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/product/:id", "destination": "/api/product-page" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/|sitemap\\.xml|robots\\.txt).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/product-page.mjs": {
      "includeFiles": "Hi-Zer-Pharma-Nutraceutical frontend/dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ],
  "crons": [
    { "path": "/api/cron/cleanup-screenshots", "schedule": "0 3 * * *" }
  ]
}
