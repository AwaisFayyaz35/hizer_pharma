# Leave blank in dev; Vite proxies /api to the backend (see vite.config.ts).
# Set to a full URL only when frontend and backend are deployed separately.
VITE_API_BASE_URL=

# Public production origin. Used for canonical URLs and sitemap.xml <loc> entries.
# Defaults to https://www.hi-zerpharmaceutical.com if unset.
VITE_SITE_URL=

# Backend origin the build-time sitemap generator reads products from.
# Falls back to VITE_API_BASE_URL, then http://localhost:5000.
# On Vercel, set this to the deployed backend URL so product pages get into sitemap.xml.
SITEMAP_API_BASE=
