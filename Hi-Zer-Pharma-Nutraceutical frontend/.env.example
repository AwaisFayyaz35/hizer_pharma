# Leave blank in dev; Vite proxies /api to the backend (see vite.config.ts).
# Set to a full URL only when frontend and backend are deployed separately.
VITE_API_BASE_URL=

# Public production origin, used for <link rel="canonical"> on storefront pages.
# Defaults to https://www.hi-zerpharmaceutical.com when unset.
VITE_SITE_URL=
